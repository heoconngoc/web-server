<form
  id="entry-form"
  class="flex flex-col gap-2 mb-6 sm:flex-row"
  hx-post="/entries"
  hx-target="#entries"
  hx-swap="beforeend"
  hx-disabled-elt="find button"
  <% if (locals.oob) { %>hx-swap-oob="true"<% } %>
>
  <label for="entry-title" class="sr-only">Title</label>
  <input type="text" id="entry-title" name="title" placeholder="Title"
         title="Shortcut: Alt+Shift+N" class="form-input">
  <label for="entry-body" class="sr-only">Body</label>
  <input type="text" id="entry-body" name="body" placeholder="Body" class="form-input">
  <button type="submit" id="entry-add" class="bg-teal-700 text-white rounded px-4 py-2 hover:bg-teal-800">Add entry</button>
</form>
