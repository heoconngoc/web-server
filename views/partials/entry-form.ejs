<form
  id="entry-form"
  class="flex flex-col gap-2 mb-6 sm:flex-row"
  hx-post="/entries"
  hx-target="#entries"
  hx-swap="beforeend"
  hx-disabled-elt="find button"
  <% if (locals.oob) { %>hx-swap-oob="true"<% } %>
>
  <input type="text" name="title" placeholder="Title" class="form-input">
  <input type="text" name="body" placeholder="Body" class="form-input">
  <button type="submit" class="bg-teal-700 text-white rounded px-4 py-2">Add entry</button>
</form>
